# ─── Required ──────────────────────────────────────────────────────────────────
# Personal API Token (JWT). In Snipe-IT: User menu → Manage API Keys → Create.
# Docs: https://snipe-it.readme.io/reference/generating-api-tokens
SNIPEIT_API_TOKEN=

# ─── Required for non-default Snipe-IT instances ───────────────────────────────
# Replace with YOUR Snipe-IT URL. The default below is an RFC 2606 placeholder
# (snipe-it.example.com is a reserved example domain that does not resolve).
SNIPEIT_API_BASE=https://snipe-it.example.com/api/v1

# ─── Optional ──────────────────────────────────────────────────────────────────
# If true, destructive tools return a redacted preview unless called with
# confirm: "YES". Default: false (writes execute directly).
SNIPEIT_CONFIRM_WRITES=false

# Per-request HTTP timeout in milliseconds. Default: 30000.
SNIPEIT_TIMEOUT_MS=30000

# Logging verbosity. Levels: debug | info | warn | error. Default: info.
# Bodies and tokens are NEVER logged regardless of this setting.
SNIPEIT_LOG_LEVEL=info
