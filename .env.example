# Required: Snipe-IT Personal API Token (JWT). Get from Snipe-IT > User > Manage API Keys.
SNIPEIT_API_TOKEN=

# Optional overrides
SNIPEIT_API_BASE=https://snipe-it.example.com/api/v1
# Write guard is ON by default: writes return a preview until re-invoked with confirm: "YES".
# Only false, 0, no or off (any case) disable it (not recommended); an empty or unknown
# value keeps it on and logs a warning.
SNIPEIT_CONFIRM_WRITES=true
SNIPEIT_TIMEOUT_MS=30000
SNIPEIT_LOG_LEVEL=info
# Cap for one tool result in bytes (serialized JSON). Default 1048576 (1 MiB), minimum 65536.
# Larger results come back shortened with truncated: true (lists also carry next_offset).
SNIPEIT_MAX_RESULT_BYTES=1048576
# Overall deadline for one tool call in ms (retries and all:true pagination included). 0 = none.
SNIPEIT_CALL_DEADLINE_MS=0
# Mask personal data (email, username, names of people, phone, address, employee number)
# in tool results. Off by default.
SNIPEIT_REDACT_PII=false
# Refuse every write at runtime (tools stay registered). Off by default.
SNIPEIT_READ_ONLY=false
# With the write guard on: confirm: "YES" executes only after a preview of the same request.
SNIPEIT_REQUIRE_PREVIEW=false
