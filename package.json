{
  "name": "the-real-snipeit-mcp",
  "version": "0.2.2",
  "mcpName": "io.github.mguttmann/the-real-snipeit-mcp",
  "description": "Unofficial MCP server for the Snipe-IT REST API: one generated tool per OpenAPI operation (read + write), hand-written wrappers for common workflows, stdio transport.",
  "license": "MIT",
  "author": "Manuel Guttmann",
  "type": "module",
  "bin": {
    "the-real-snipeit-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "homepage": "https://github.com/mguttmann/the-real-snipeit-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mguttmann/the-real-snipeit-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mguttmann/the-real-snipeit-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "snipe-it",
    "snipeit",
    "asset-management",
    "it-asset-management",
    "claude",
    "anthropic",
    "openapi",
    "stdio"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "!dist/codegen",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "codegen": "tsx src/codegen/generate.ts",
    "refresh-spec": "bash scripts/refresh-spec.sh",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "coverage": "vitest run --coverage",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prebuild": "npm run lint && npm run typecheck && npm run test:unit",
    "test:contract": "vitest run tests/unit/toolContract.test.ts tests/unit/protocolVersions.test.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^16.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.13.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.6",
    "yaml": "^2.9.1"
  }
}
